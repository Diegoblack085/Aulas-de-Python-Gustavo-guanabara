#Operadores
# + soma
# - subtração
# * Multiplição
# / Divisão
# // Divisão inteira
# ** Potência
# % Modulo ou resto da Divisão
n1 = int(input('Digite um numero: '))
n2 = int(input('Digite outro valor: '))
s = n1 + n2
m = n1 * n2
d = n1 / n2
e = n1 ** n2
r = n1 % n2
dc = n1 // n2
print('A soma entre {} e {} vale {:=^20}!'.format(n1,n2,s), end=' ')
print('A multiplicação entre {} e {} é {}'.format(n1,n2,m))
print('A divisão entre {} e {} é {:.3f}'.format(n1,n2,d))
print('A exponênciação entre {} e {} é {}'.format(n1,n2,e))
print('O resto da divisão entre {} e {} é {}'.format(n1,n2,r))
print('A divisão inteira entre {} e {} é {}'.format(n1,n2,dc))

